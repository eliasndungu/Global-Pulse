# ──────────────────────────────────────────────
#  Global-Pulse – Environment Variables Example
#  Copy to .env and fill in the real values.
# ──────────────────────────────────────────────

# ── PostgreSQL / TimescaleDB ──────────────────
POSTGRES_USER=globalpulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=globalpulse
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# ── Redis (Airflow broker / result backend) ───
REDIS_HOST=redis
REDIS_PORT=6379

# ── Apache Airflow ────────────────────────────
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__FERNET_KEY=REPLACE_WITH_FERNET_KEY
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}/${POSTGRES_DB}
AIRFLOW__CELERY__BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}/${POSTGRES_DB}
AIRFLOW_UID=50000

# ── External API Keys ─────────────────────────
MARINETRAFFIC_API_KEY=your_marinetraffic_key_here
OPENWEATHER_API_KEY=your_openweathermap_key_here
NEWS_RSS_URLS=https://feeds.reuters.com/reuters/businessNews,https://rss.cnn.com/rss/money_news_international.rss

# ── FastAPI / Global-Pulse REST API ──────────
API_SECRET_KEY=REPLACE_WITH_STRONG_SECRET
API_ALGORITHM=HS256
API_KEY_EXPIRE_DAYS=365
API_HOST=0.0.0.0
API_PORT=8000

# ── Forecasting ───────────────────────────────
FORECAST_HORIZON_DAYS=7
MODEL_STORE_PATH=/app/model_store
